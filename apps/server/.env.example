
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
LOG_LEVEL="info"

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://u:p@localhost:5432/db"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://u:p@localhost:5432/db"

# --- Privy ---
#
# THIS FILE IS COMMITTED. Never put a real secret here -- a secret pasted into
# this file is a secret published. Real values belong in .env, which is gitignored.
#
# PRIVY_APP_ID is a public identifier and ships in the client bundle, so it is
# safe here. APP_SECRET and VERIFICATION_KEY are not; leave them empty.
PRIVY_APP_ID="cmu3mt6bp029x0cl5tnp2wku4"
PRIVY_APP_SECRET=""
PRIVY_VERIFICATION_KEY=""

# Public base URL of this API (required by src/env.ts)
PUBLIC_URL="http://localhost:4000"
