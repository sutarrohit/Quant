# @quant/api -- apps/server. Loaded by src/env.ts per NODE_ENV.
# NEVER commit real values: .env and .env.production are gitignored, .env.example is not.

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------
NODE_ENV=development                # development | test | production
PORT=4000
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace|silent

# --------------------------------------------------------------------------
# URLs
# --------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000  # exact origin; CORS credentials reject *
PUBLIC_URL=http://localhost:4000    # this API's own public base

# --------------------------------------------------------------------------
# Postgres
# --------------------------------------------------------------------------
DATABASE_URL=                       # pooled; runtime queries
DIRECT_URL=                         # unpooled; migrations only

# --------------------------------------------------------------------------
# Privy
# --------------------------------------------------------------------------
# APP_ID must match the web app's, or tokens fail their audience check.
PRIVY_APP_ID=cmu3mt6bp029x0cl5tnp2wku4  # public identifier
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=             # public key; verifies tokens locally

# --------------------------------------------------------------------------
# Engine service (Phase 2)
# --------------------------------------------------------------------------
ENGINE_URL=http://localhost:8000
ENGINE_INTERNAL_API_KEY=            # must equal the engine's NT_INTERNAL_API_KEY
