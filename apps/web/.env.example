# Server-only (no NEXT_PUBLIC_ prefix): where next.config.ts proxies /api/v1/* to.
# Because the browser only ever calls this app's own origin, the API does NOT
# need to share a domain with this app -- see docs/privy-auth-integration.md 2.1.
API_URL="http://localhost:4000"

# Privy. Both are public identifiers; the App Secret is server-only and belongs
# in apps/server/.env, never here.
# Use the DEV app ID -- production needs its own, bound to a verified domain.
NEXT_PUBLIC_PRIVY_APP_ID="cmu3mt6bp029x0cl5tnp2wku4"
# Optional -- only some dashboard configurations issue a client ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=""
