# @quant/web -- apps/web. Next.js loads .env.production automatically on a production build.
# Only NEXT_PUBLIC_* reaches the browser. Never put a secret in one.

# --------------------------------------------------------------------------
# API
# --------------------------------------------------------------------------
# Server-only. next.config.ts proxies /api/v1/* here, so the browser never sees it.
API_URL=http://localhost:4000

# --------------------------------------------------------------------------
# Privy
# --------------------------------------------------------------------------
# Both are public identifiers. The App Secret belongs in apps/server, never here.
NEXT_PUBLIC_PRIVY_APP_ID=  # production needs its own app id
NEXT_PUBLIC_PRIVY_CLIENT_ID=        # optional; some dashboards issue one
