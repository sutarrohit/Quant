# /etc/engine-server.env -- install with mode 0600, owned by nautilus.
# It holds the bearer token.
#
#   sudo install -m 0600 -o nautilus deploy/systemd/engine-server.env /etc/engine-server.env
#   sudo -e /etc/engine-server.env
#
# Every setting is read by pydantic-settings with the NT_ prefix. There is
# deliberately no NT_DATABASE_URL: this service never connects to the platform
# PostgreSQL (spec section 9.4).
#
# One file, read by all three units. Each process ignores what it does not need.

# --- required by every process --------------------------------------------

# Shared bearer token presented by the TypeScript api-control service.
# The API refuses to start without it. Generate with: openssl rand -hex 32
NT_INTERNAL_API_KEY=change-me

NT_LOG_LEVEL=INFO
NT_CATALOG_PATH=/var/lib/engine-server/catalog

# The arq job queue, and the live desired-state records.
NT_REDIS_URL=redis://localhost:6379/0

# --- engine-live.service --------------------------------------------------
# The unit refuses to start without these, naming which one is missing or
# unreachable (PreflightFailed). That is deliberate: TradingNode construction
# blocks FOREVER on an unreachable cache Redis and does not die on SIGTERM
# (docs/nautilus-api-notes.md D16), so a unit that fails to start is much
# better than one that wedges and takes every account with it.

# Nautilus's live cache: open orders and positions, and what a restart recovers
# from. A DIFFERENT REDIS INSTANCE, not a different database index --
# DatabaseConfig exposes no DB index (D15), so it is the port that separates
# them and not the trailing /0. See deploy/systemd/README.md for setting up the
# second instance on 6380.
NT_CACHE_REDIS_URL=redis://localhost:6380/0

# --- venue credentials (ADR-001) -------------------------------------------
# Where a key is mounted at runtime, one file per credentialRef. NEVER in the
# image, NEVER an environment variable, NEVER the repo -- a secrets manager
# projects onto this directory:
#
#   Kubernetes   a Secret volume, or a CSI driver fronting Vault/AWS/GCP
#   compose      secrets:, mounted under /run/secrets
#   systemd      LoadCredential=, exposed at $CREDENTIALS_DIRECTORY
#
# Each file is named for the account's credentialRef and holds:
#
#   {"api_key": "...", "api_secret": "..."}
#
# A file readable beyond its owner is REFUSED rather than loaded. Create one:
#
#   sudo install -d -o nautilus -g nautilus -m 0700 /var/lib/engine-server/secrets
#   sudo -u nautilus tee /var/lib/engine-server/secrets/binance-main <<'JSON'
#   {"api_key": "your key", "api_secret": "your secret"}
#   JSON
#   sudo chmod 600 /var/lib/engine-server/secrets/binance-main
#
# Use a READ-ONLY key first. Reconciliation only calls query_spot_account_info
# and query_open_orders -- it never places or cancels anything -- so a key that
# cannot trade is enough to test a live start, and cannot do harm if some other
# gate fails. Whatever key you use: withdrawals disabled, IP allowlisted.
NT_LIVE_SECRETS_DIR=/var/lib/engine-server/secrets

# The documented exception (ADR-001 addendum, 2026-09-08). With this true, live
# keys are read from the environment instead of a file:
#
#   NT_VENUE_<REFERENCE>_KEY
#   NT_VENUE_<REFERENCE>_SECRET
#
# where <REFERENCE> is the account's credentialRef, uppercased with - as _.
# So credentialRef "binance-main" reads NT_VENUE_BINANCE_MAIN_KEY and
# NT_VENUE_BINANCE_MAIN_SECRET.
#
# Off by default, and it logs a WARNING on every node start when on. What the
# default is protecting against: an environment variable is inherited by every
# child process, is readable at /proc/<pid>/environ, spreads to docker inspect
# and CI logs and shell history, and -- unlike a file -- has no mode to check
# before it is read.
NT_LIVE_ALLOW_ENV_CREDENTIALS=false

# The on-disk kill switch: the path that works when Redis and the API do not.
#   sudo -u nautilus touch /var/lib/engine-server/kill/kill-acct_1
#   sudo -u nautilus touch /var/lib/engine-server/kill/kill-all
# A TOTAL stop within seconds: nothing reaches the venue, exits included. The
# position is then yours to close at the exchange. The directory must exist, be
# owned by nautilus, and sit under the unit's ReadWritePaths.
NT_LIVE_KILL_SWITCH_DIR=/var/lib/engine-server/kill

# How long a supervisor's claim on an account survives without renewal; how
# long a node may go silent before it is presumed dead; and how often a running
# node re-reads its kill switch.
NT_LIVE_LEASE_SECONDS=30
NT_LIVE_HEARTBEAT_TIMEOUT_SECONDS=90
NT_LIVE_KILL_SWITCH_INTERVAL_SECONDS=5

# A node that fails to start is retried after this, doubling to the ceiling. A
# node must run for the third value before its start counts as a success --
# being briefly in the process table is not one, and that is the exact shape
# of every live defect found so far.
NT_LIVE_RESTART_BACKOFF_SECONDS=5
NT_LIVE_RESTART_BACKOFF_MAX_SECONDS=300
NT_LIVE_HEALTHY_AFTER_SECONDS=60

# There is no setting that enables real-money trading. TradingMode.LIVE raises
# LiveNotPermitted until the seven conditions in docs/adr-001-live-execution.md
# are met, and none are. Paper is the only mode that runs.

# --- engine-worker@.service -----------------------------------------------

NT_ARTIFACT_PATH=/var/lib/engine-server/artifacts
NT_RAW_PATH=/var/lib/engine-server/raw

# Wall-clock ceiling for one backtest; a run past it is killed (TIMEOUT).
# TimeoutStopSec in the unit is the backstop above this, not the mechanism.
NT_BACKTEST_TIMEOUT_SECONDS=900

# Where completed summaries are POSTed. Leave unset until api-control exists.
# NT_API_CONTROL_URL=http://api-control:3000
