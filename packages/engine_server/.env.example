# Every setting is read by pydantic-settings with the NT_ prefix.
#
#   cp .env.example .env
#   openssl rand -hex 32        # then set NT_INTERNAL_API_KEY
#
# There is deliberately no NT_DATABASE_URL: this service never connects to the
# platform PostgreSQL (spec section 9.4).
#
# --------------------------------------------------------------------------
# TO RUN LIVE (PAPER), you need everything down to "backtests" and:
#
#   redis-server --port 6379 --daemonize yes            # queue + live state
#   redis-server --port 6380 --daemonize yes            # Nautilus cache
#   mkdir -p run/kill
#   uv run fastapi run src/engine/api/app.py --port 8000
#   uv run python -m engine.live.main
#
# The arq worker is NOT needed for live -- that is backtests only.
# --------------------------------------------------------------------------

# --- required by every process --------------------------------------------

# Shared bearer token presented by the TypeScript api-control service.
# The API refuses to start without it. Generate with: openssl rand -hex 32
NT_INTERNAL_API_KEY=change-me-generate-with-openssl-rand-hex-32

NT_LOG_LEVEL=INFO

# Parquet catalog root. Local path or s3://... via fsspec.
NT_CATALOG_PATH=./catalog

# The arq job queue, and the live desired-state records.
NT_REDIS_URL=redis://localhost:6379/0

# --- live control plane ---------------------------------------------------
# `uv run python -m engine.live.main` refuses to boot without these, naming
# which one is missing or unreachable. That is deliberate: TradingNode
# construction blocks FOREVER on an unreachable cache Redis and does not die on
# SIGTERM (docs/nautilus-api-notes.md D16), so a deploy that fails is much
# better than one that wedges.

# Nautilus's live cache: open orders and positions, and what a restart recovers
# from. Must be a DIFFERENT REDIS INSTANCE from NT_REDIS_URL, not a different
# database index -- DatabaseConfig exposes no DB index (D15), so it is the port
# that separates them and not the trailing /0. Both would otherwise land on
# database 0 of one server, and a FLUSHDB aimed at the queue would erase live
# position state.
NT_CACHE_REDIS_URL=redis://localhost:6380/0

# The on-disk kill switch: the path that works when Redis and the API do not.
#   touch ./run/kill/kill-acct_1     # one account
#   touch ./run/kill/kill-all        # everything
# It is a TOTAL stop: nothing at all reaches the venue, exits included. You
# reach for a kill switch when you do not trust the strategy, and a strategy
# you do not trust should not be closing positions either -- its idea of an
# exit may be the bug. The position is then yours to close at the exchange.
# The directory must exist and be writable.
NT_LIVE_KILL_SWITCH_DIR=./run/kill

# How long a supervisor's claim on an account survives without renewal; how
# long a node may go silent before it is presumed dead; and how often a running
# node re-reads its kill switch. The last is bounded well below the gate's
# 30s staleness bound, so an ordinary slow tick does not stop trading.
NT_LIVE_LEASE_SECONDS=30
NT_LIVE_HEARTBEAT_TIMEOUT_SECONDS=90
NT_LIVE_KILL_SWITCH_INTERVAL_SECONDS=5

# A node that fails to start is retried after this, doubling each time up to
# the ceiling. Without it a node that dies during startup is respawned every
# pass, forever -- and against a real venue that is also how an IP gets
# rate-limited. A node must run for the third value before its start counts as
# a success, because being briefly in the process table is not one.
NT_LIVE_RESTART_BACKOFF_SECONDS=5
NT_LIVE_RESTART_BACKOFF_MAX_SECONDS=300
NT_LIVE_HEALTHY_AFTER_SECONDS=60

# There is no setting that enables real-money trading. TradingMode.LIVE raises
# LiveNotPermitted until the seven conditions in docs/adr-001-live-execution.md
# are met, and none are. Paper is the only mode that runs.

# --- backtests ------------------------------------------------------------
# Only needed if you are also running `uv run arq engine.worker.main.WorkerSettings`.

# Backtest result artifacts (summary JSON, equity/drawdown/trade parquet).
NT_ARTIFACT_PATH=./artifacts

# Raw exchange responses, written before any transformation. Append-only audit
# trail; never overwritten. Used by the ingest CLI.
NT_RAW_PATH=./raw

# Wall-clock ceiling for one backtest; a run past it is killed (TIMEOUT).
NT_BACKTEST_TIMEOUT_SECONDS=900

# Where completed summaries are POSTed. Leave unset until api-control exists --
# results are still computed, stored and pollable without it.
# NT_API_CONTROL_URL=http://api-control:3000
