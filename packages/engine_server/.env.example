# engine_server -- read by pydantic-settings with the NT_ prefix.
# No NT_DATABASE_URL, ever: this service never touches the platform Postgres.

# --------------------------------------------------------------------------
# Core
# --------------------------------------------------------------------------
NT_ENV=development                  # picks .env or .env.production
NT_LOG_LEVEL=INFO                   # DEBUG|INFO|WARNING|ERROR|CRITICAL
NT_INTERNAL_API_KEY=                # openssl rand -hex 32; API refuses to start without it

# --------------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------------
# Local path or an fsspec URI (s3://...). s3:// needs the s3fs extra installed.
NT_CATALOG_PATH=./catalog           # parquet market data
NT_RAW_PATH=./raw                   # unmodified exchange responses
NT_ARTIFACT_PATH=./artifacts        # backtest summaries, equity, trades

# --------------------------------------------------------------------------
# AWS (only when a path above is s3://)
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------
# Two different INSTANCES, not two DB indexes: DatabaseConfig has no DB index (D15),
# so a FLUSHDB aimed at the queue would otherwise erase live position state.
NT_REDIS_URL=redis://localhost:6379/0  # arq queue + live desired state
NT_CACHE_REDIS_URL=redis://localhost:6380/0  # Nautilus live cache; required for live

# --------------------------------------------------------------------------
# Backtests
# --------------------------------------------------------------------------
NT_BACKTEST_TIMEOUT_SECONDS=900     # a run past this is killed (TIMEOUT)
NT_JOB_TTL_SECONDS=604800           # 7d; how long a job record is readable
NT_API_CONTROL_URL=                 # where finished summaries are POSTed; unset = inert

# --------------------------------------------------------------------------
# Live control plane
# --------------------------------------------------------------------------
# touch $NT_LIVE_KILL_SWITCH_DIR/kill-<accountId> to stop one account, kill-all for every one.
NT_LIVE_KILL_SWITCH_DIR=./run/kill  # must exist and be writable
NT_LIVE_SECRETS_DIR=./run/secrets   # one 0600 file per credentialRef
NT_LIVE_LEASE_SECONDS=30            # a supervisor's claim on an account
NT_LIVE_HEARTBEAT_TIMEOUT_SECONDS=90  # silent longer than this = presumed dead
NT_LIVE_KILL_SWITCH_INTERVAL_SECONDS=5  # how often a node re-reads its switch
NT_LIVE_RESTART_BACKOFF_SECONDS=5   # doubles per consecutive failure
NT_LIVE_RESTART_BACKOFF_MAX_SECONDS=300
NT_LIVE_HEALTHY_AFTER_SECONDS=60    # run this long before a start counts

# --------------------------------------------------------------------------
# Venue credentials (ADR-001)
# --------------------------------------------------------------------------
# ADR-001 wants keys in NT_LIVE_SECRETS_DIR, not here: an env var is inherited by every
# child process and shows in /proc, docker inspect and CI logs. true is a visible exception.
# There is no setting that enables real-money trading. SIMULATION is the only mode that runs.
NT_LIVE_ALLOW_ENV_CREDENTIALS=false # ADR-001 forbids true
NT_VENUE_BINANCE_MAIN_KEY=          # use a READ-ONLY key
NT_VENUE_BINANCE_MAIN_SECRET=
