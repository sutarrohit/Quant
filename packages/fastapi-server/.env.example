# Required. Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# "development" enables create_all on startup; use "production" to rely on Alembic only
ENVIRONMENT=development

# Any SQLAlchemy async URL, e.g. postgresql+asyncpg://user:pass@localhost/blog
DATABASE_URL=sqlite+aiosqlite:///./blog.db

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
