{
  "$schema": "https://json.schemastore.org/tsconfig",

  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "incremental": false,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",

    "rootDir": "src",
    "outDir": "dist",

    "types": ["node"]
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
