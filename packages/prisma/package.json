{
  "name": "@repo/prisma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema.prisma",
    "migrations"
  ],
  "scripts": {
    "postinstall": "prisma generate && tsc",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "build": "prisma generate && tsc",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "prisma": "^7.8.0",
    "typescript": "^5.8.3"
  }
}
