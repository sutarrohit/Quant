datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model User {
  id                      String     @id @default(uuid())
  name                    String
  email                   String
  emailVerified           Boolean    @default(false)
  image                   String?
  onboardingCompletedAt   DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  sessions                Session[]
  accounts                Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Phase 1 quant tables (VALID-01, DATA-03) ---
//
// Deliberate deviation from the four models above: `id` here is generated by Postgres itself
// (dbgenerated, see prisma/README.md), not by the Prisma client. The four better-auth models
// generate their id client-side via `@default(uuid())`, which leaves Postgres with no DEFAULT
// for that column — fine for a client that always sets `id`, but wrong for a bare SQLAlchemy
// Core INSERT that omits it. Do not "fix" the pattern below to match the four models above.
//
// Every multi-word field on these three models carries an explicit @map to a snake_case
// physical column name. Prisma does NOT derive snake_case from camelCase automatically — see
// `emailVerified`/`accessTokenExpiresAt` above, which stay camelCase in Postgres with no @map.

model Trial {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  strategyLineageId  String   @map("strategy_lineage_id")
  paramsHash         String   @map("params_hash")
  objective          String
  ranAt              DateTime @default(now()) @map("ran_at")
  wasOos             Boolean  @map("was_oos")
  status             String
  errorMessage       String?  @map("error_message")

  @@index([strategyLineageId])
  @@index([paramsHash])
  @@map("trials")
}

model SnapshotCapture {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  captureDate         DateTime                 @db.Date @map("capture_date")
  capturedAt          DateTime                 @map("captured_at")
  payloadSha256       String                   @map("payload_sha256")
  expectedSymbolCount Int                      @map("expected_symbol_count")
  actualSymbolCount   Int                      @map("actual_symbol_count")
  status              String
  symbols             SymbolListingSnapshot[]

  @@index([captureDate])
  @@map("snapshot_capture")
}

model SymbolListingSnapshot {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  captureId   String          @db.Uuid @map("capture_id")
  capture     SnapshotCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  rawPayload  Bytes           @map("raw_payload")
  symbol      String
  status      String
  baseAsset   String          @map("base_asset")
  quoteAsset  String          @map("quote_asset")
  tickSize    Decimal         @db.Decimal(38, 18) @map("tick_size")
  stepSize    Decimal         @db.Decimal(38, 18) @map("step_size")
  minNotional Decimal?        @db.Decimal(38, 18) @map("min_notional")
  capturedAt  DateTime        @map("captured_at")

  @@index([capturedAt])
  @@index([symbol, capturedAt])
  @@index([captureId])
  @@map("symbol_listing_snapshot")
}
