datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// Identity is Privy's. This row exists only to hang domain data off (onboarding,
// and later tenancy and exchange accounts), keyed by the Privy DID.
//
// `name` and `email` are nullable because a wallet-only Privy login carries
// neither -- never key domain data off `email`. Postgres permits multiple NULLs
// under a unique index, so @@unique([email]) is still correct.
//
// Session/Account/Verification are gone: Privy owns the session entirely, so the
// server never issues or stores one. `emailVerified` is gone for the same reason
// -- Privy's linked-account state is the truth.
//
// Column names here stay camelCase with no @map, matching this table's existing
// convention (see onboardingCompletedAt). That differs deliberately from the
// quant tables below, which are snake_case with explicit @map.
model User {
  id                    String    @id @default(uuid())
  privyDid              String
  name                  String?
  email                 String?
  image                 String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([privyDid])
  @@unique([email])
  @@map("user")
}

// --- Phase 1 quant tables (VALID-01, DATA-03) ---
//
// Deliberate deviation from the User model above: `id` here is generated by Postgres itself
// (dbgenerated, see prisma/README.md), not by the Prisma client. User generates its id
// client-side via `@default(uuid())`, which leaves Postgres with no DEFAULT for that column
// — fine for a client that always sets `id`, but wrong for a bare SQLAlchemy Core INSERT
// that omits it. Do not "fix" the pattern below to match User.
//
// Every multi-word field on these three models carries an explicit @map to a snake_case
// physical column name. Prisma does NOT derive snake_case from camelCase automatically — see
// `privyDid`/`onboardingCompletedAt` above, which stay camelCase in Postgres with no @map.

model Trial {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  strategyLineageId  String   @map("strategy_lineage_id")
  paramsHash         String   @map("params_hash")
  objective          String
  ranAt              DateTime @default(now()) @map("ran_at")
  wasOos             Boolean  @map("was_oos")
  status             String
  errorMessage       String?  @map("error_message")

  @@index([strategyLineageId])
  @@index([paramsHash])
  @@map("trials")
}

model SnapshotCapture {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  captureDate         DateTime                 @db.Date @map("capture_date")
  capturedAt          DateTime                 @map("captured_at")
  payloadSha256       String                   @map("payload_sha256")
  expectedSymbolCount Int                      @map("expected_symbol_count")
  actualSymbolCount   Int                      @map("actual_symbol_count")
  status              String
  symbols             SymbolListingSnapshot[]

  @@index([captureDate])
  @@map("snapshot_capture")
}

model SymbolListingSnapshot {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  captureId   String          @db.Uuid @map("capture_id")
  capture     SnapshotCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  rawPayload  Bytes           @map("raw_payload")
  symbol      String
  status      String
  baseAsset   String          @map("base_asset")
  quoteAsset  String          @map("quote_asset")
  tickSize    Decimal         @db.Decimal(38, 18) @map("tick_size")
  stepSize    Decimal         @db.Decimal(38, 18) @map("step_size")
  minNotional Decimal?        @db.Decimal(38, 18) @map("min_notional")
  capturedAt  DateTime        @map("captured_at")

  @@index([capturedAt])
  @@index([symbol, capturedAt])
  @@index([captureId])
  @@map("symbol_listing_snapshot")
}
