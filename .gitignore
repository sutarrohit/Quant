# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Local SQLite databases
*.db
*.db-journal

# cross-AI review lane diagnostics (local only)
.review-diagnostics/

# Generated contract artifacts (D-06)
engine/generated/
schemas/generated/

# Generated Prisma client (@repo/prisma owns it; `pnpm --filter @repo/prisma db:generate`)
packages/prisma/src/generated/

# Backtest run outputs (D-19, D-20)
runs/
*.png

# Local data catalog cache (D-23)
catalog/
.data-cache/

# Python bytecode caches (no per-directory .gitignore of their own, unlike .venv/.pytest_cache/.ruff_cache)
__pycache__/
*.pyc
